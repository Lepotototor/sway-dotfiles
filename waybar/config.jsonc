{
  "layer": "bottom",
  "position": "top",
  "height": 44,
  "spacing": 2,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,
  "modules-left": [
		"battery",
		"memory",
		"cpu",
		"sway/window"
  ],
  "modules-center": [
		"sway/workspaces",
		"mpris",
		"clock",
		"clock#simpleclock"
  ],
  "modules-right": [
		"custom/screenshot",
		"custom/colorpicker",
		"pulseaudio",
		"bluetooth",
		"tray",
		"custom/notification"
  ],

 "battery": {
   "states": {
      	"warning": 30,
       	"critical": 15
      },
       	"format": "{icon} {capacity}%",
       	"format-charging": " {capacity}%",
       	"format-plugged": "{capacity}%",
       	"format-alt": "{time} {icon}",
       	"format-full": " {capacity}%",
	"format-icons": [" ", " ", " ", " ", " "]	
	},
  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "interval": 1
  },
  "memory": {
    "format": "  {used:0.1f}Go"
  },

  "sway/window": {
    "format": "{title}",
    "max-length": 40
  },

  "sway/workspaces": {
	"disable-scroll": false,
  	"all-outputs": true,
  	"persistent-workspaces": {
  	  "1": [],
  	  "2": [],
  	  "3": [],
  	  "4": [],
  	  "5": []
  	},
  	"format": "{icon}",
  	"format-icons": {
  	  "1": "💋",
  	  "2": "🎀",
  	  "3": "🌸",
  	  "4": "🍓",
  	  "5": "🌷",
	  "default": "🍒"
  	}
  },	

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "max-length": 20
  },

  "clock#simpleclock": {
    "tooltip": false,
    "format": " {:%H:%M}"
  },
  "clock": {
    "format": " {:L%a %d %b}",
    "calendar": {
      "format": {
        "days": "<span weight='normal'>{}</span>",
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "today": "<span color='#f38ba8' weight='700'><u>{}</u></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "weeks": "<span color='#a6e3a1'><b>W{}</b></span>"
      },
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1
    },
    "tooltip-format": "<span color='#cdd6f4' font='Lexend 16'><tt><small>{calendar}</small></tt></span>"
  },
  "pulseaudio": {
    "format": "{icon}{volume}%",
    "format-muted": "  muted",
    "format-icons": {
	    "headphone": "",
	    "default": [" ", " ", " "]
	    },
    "on-click": "pavucontrol"
    
  },

  "custom/screenshot": {
    "format": "⛶",
    "tooltip-format": "Clic gauche : capture d'une zone\nClic droit : capture plein écran",
    "on-click": "$HOME/.config/waybar/scripts/screenshot.sh area",
    "on-click-right": "$HOME/.config/waybar/scripts/screenshot.sh full"
  },

  "custom/colorpicker": {
    "format": "🧪",
    "tooltip-format": "Pipette à couleur (copie le code hex)",
    "on-click": "$HOME/.config/waybar/scripts/colorpicker.sh"
  },

  "custom/sep": {
    "format": "|",
    "tooltip": false
  },

  "bluetooth": {
    "format": " {status}",
    "format-connected" : " {device-alias}",
    "tooltip": true,
    "on-click": "blueberry"
  },

  "tray": {
    "show-passive-items": true,
    "spacing": 10
  },

  "network": {
    "interface": "wlp3s0",
    "format": "{ifname}",
    "format-wifi": "{essid} ",
    "max-length": 50,
    "on-click": "$HOME/.config/waybar/scripts/rofi-wifi-menu.sh"
  },

  "custom/notification": {
    "escape": true,
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "format": "{icon}",
    "format-icons": {
      "none": "󰅺",
      "notification": "󰡟"
    },
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "return-type": "json",
    "tooltip": false
  }
}
